  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.0.0",
    "gh-pages": "^6.1.1",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
